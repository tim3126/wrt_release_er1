#!/bin/sh
# China Mobile (CMCC) IPv4 addresses for PBR
# Data source: https://ispip.clang.cn/cmcc.txt
TARGET_URL='https://ispip.clang.cn/cmcc.txt'
TARGET_DL_FILE="${TARGET_DL_FILE:-/var/pbr_tmp_cmcc_ip.txt}"
TARGET_TABLE='inet fw4'
TARGET_INTERFACE='wan_cmcc'

_ret=1
_download_tmp="${TARGET_DL_FILE}.download.$$"

mkdir -p "${TARGET_DL_FILE%/*}" || return 1
rm -f "$_download_tmp"

# Do not reuse a stale cache: transport or TLS validation failure must leave
# the nft set unchanged.
if ! uclient-fetch -qO "$_download_tmp" "$TARGET_URL"; then
    rm -f "$_download_tmp"
    return 1
fi

params=$(
    awk -F'[./]' '
        NF == 5 &&
        $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ &&
        $3 ~ /^[0-9]+$/ && $4 ~ /^[0-9]+$/ &&
        $5 ~ /^[0-9]+$/ {
            if ($1 > 255 || $2 > 255 || $3 > 255 || $4 > 255 || $5 > 32) {
                invalid = 1
                next
            }
            if (params != "")
                params = params ", "
            params = params sprintf("%d.%d.%d.%d/%d", $1, $2, $3, $4, $5)
            valid = 1
            next
        }
        { invalid = 1 }
        END {
            if (invalid || !valid)
                exit 1
            printf "%s", params
        }
    ' "$_download_tmp"
) || {
    rm -f "$_download_tmp"
    return 1
}

nftset="pbr_${TARGET_INTERFACE}_4_dst_ip_user"
if ! nft -c "add element $TARGET_TABLE $nftset { $params }"; then
    rm -f "$_download_tmp"
    return 1
fi
if nft "add element $TARGET_TABLE $nftset { $params }"; then
    mv -f "$_download_tmp" "$TARGET_DL_FILE" || {
        rm -f "$_download_tmp"
        return 1
    }
    _ret=0
else
    rm -f "$_download_tmp"
fi

return $_ret
