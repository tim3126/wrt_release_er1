diff --git a/feeds/packages/net/frp/files/frpc.init b/feeds/packages/net/frp/files/frpc.init
index 68fe43c..4952e3c 100755
--- a/feeds/packages/net/frp/files/frpc.init
+++ b/feeds/packages/net/frp/files/frpc.init
@@ -49,8 +49,9 @@ start_service() {
 	> "$conf_file"
 	config_load "$NAME"
 
-	local stdout stderr user group respawn env conf_inc
+	local enabled stdout stderr user group respawn env conf_inc
 	uci_validate_section "$NAME" init "$init_cfg" \
+		'enabled:bool:0' \
 		'stdout:bool:1' \
 		'stderr:bool:1' \
 		'user:string' \
@@ -65,6 +66,9 @@ start_service() {
 		return 1
 	}
 
+	# TAIYI_FRPC_DEFAULT_DISABLED: an unconfigured client must stay idle.
+	[ "$enabled" -eq 1 ] || return 0
+
 	[ -n "$conf_inc" ] && config_list_foreach "$init_cfg" conf_inc cat >> "$conf_file"
 
 	procd_open_instance
