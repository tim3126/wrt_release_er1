#!/bin/sh
# Fail-closed gate for LuCI-triggered APK component-group upgrades on Taiyi.
set -eu

APK_BIN=${APK_BIN:-/usr/bin/apk}
CATALOG_FILE=${TAIYI_APK_PLUGIN_CATALOG:-/usr/share/taiyi/apk-plugin-catalog}
GROUPS_FILE=${TAIYI_APK_PLUGIN_GROUPS:-/usr/share/taiyi/apk-plugin-groups}
BASELINE_FILE=${TAIYI_APK_BASELINE:-/etc/taiyi/apk-baseline-packages}

die() {
    printf 'Taiyi APK policy: %s\n' "$*" >&2
    exit 1
}

package_class() {
    awk -v package_name="$1" '
        $1 !~ /^#/ && $2 == package_name { print $1; exit }
    ' "$CATALOG_FILE"
}

package_group() {
    awk -v package_name="$1" '
        $1 !~ /^#/ && $2 == package_name { print $1; exit }
    ' "$GROUPS_FILE"
}

is_platform_package() {
    case "$1" in
        kernel|kernel-*|kmod-*|apk|apk-*|openwrt-keyring|openwrt-keyring-*|\
        libc|musl|musl-*|gcc|gcc-*|libgcc|libgcc-*|libstdc++|libstdc++-*|\
        base-files|busybox|procd|procd-*|ubus|ubus-*|ubusd|ubusd-*|\
        uci|uci-*|libuci|libuci-*|libubus|libubus-*|libubox|libubox-*|\
        libblobmsg-json|libblobmsg-json-*|rpcd|rpcd-*|ucode|\
        ucode-mod-fs|ucode-mod-ubus|ucode-mod-uci|ucode-mod-uloop|\
        firewall4|fw4|nftables|nftables-*|netifd|netifd-*|\
        dnsmasq|dnsmasq-*|odhcpd|odhcpd-*|odhcp6c|odhcp6c-*|\
        ppp|ppp-*|ip-full|ip-tiny|iproute2|iproute2-*|tc|tc-*|\
        ca-bundle|ca-certificates|libustream-*|jsonfilter|uhttpd|uhttpd-*|\
        dropbear|dropbear-*|luci-app-package-manager|\
        luci-base|luci-compat|luci-mod-*|luci-lib-base|\
        nss|nss-*|*nss*|qca-nss-*|ecm|ecm-*|*ecm*|kmod-qca-*|kmod-ecm*)
            return 0
            ;;
    esac
    return 1
}

append_unique() {
    output_file=$1
    package_name=$2
    if ! grep -qFx "$package_name" "$output_file"; then
        printf '%s\n' "$package_name" >>"$output_file"
    fi
}

parse_plan() {
    plan_file=$1
    parsed_file=$2

    awk '
        NF == 0 { next }
        $1 ~ /^\([0-9]+\/[0-9]+\)$/ {
            if ($2 != "Installing" && $2 != "Upgrading")
                exit 2
            if ($3 !~ /^[A-Za-z0-9][A-Za-z0-9+_.-]*$/)
                exit 2
            print $3
            next
        }
        $1 == "OK:" { next }
        { exit 2 }
    ' "$plan_file" >"$parsed_file"
}

validate_plan() {
    parsed_file=$1
    selected_group=$2
    seen_file=$3
    : >"$seen_file"

    while IFS= read -r package_name; do
        [ -n "$package_name" ] || continue
        if grep -qFx "$package_name" "$seen_file"; then
            die "solver plan contains duplicate package '$package_name'"
        fi
        printf '%s\n' "$package_name" >>"$seen_file"

        if is_platform_package "$package_name"; then
            die "solver plan includes firmware-bound platform package '$package_name'"
        fi

        class=$(package_class "$package_name")
        case "$class" in
            safe|network-critical) ;;
            firmware-only)
                die "solver plan includes firmware-only package '$package_name'"
                ;;
            *)
                die "solver plan includes unclassified package '$package_name'"
                ;;
        esac

        candidate_group=$(package_group "$package_name")
        if [ "$candidate_group" != "$selected_group" ]; then
            die "solver plan crosses component group via '$package_name'"
        fi

        if [ -f "$BASELINE_FILE" ] && grep -qFx "$package_name" "$BASELINE_FILE"; then
            die "solver plan changes immutable baseline package '$package_name'"
        fi
    done <"$parsed_file"
}

[ "${1:-}" = upgrade ] || die "only explicit component-group upgrades are allowed"
shift
[ "$#" -gt 0 ] || die "a reviewed package name is required"
[ "$#" -le 16 ] || die "too many requested package names"
[ -x "$APK_BIN" ] || die "apk executable is unavailable"
[ -f "$CATALOG_FILE" ] || die "package catalog is unavailable"
[ -f "$GROUPS_FILE" ] || die "package group policy is unavailable"

work_dir=$(mktemp -d /tmp/taiyi-apk-policy.XXXXXX)
trap 'rm -rf "$work_dir"' EXIT INT TERM
requested_file="$work_dir/requested"
transaction_file="$work_dir/transaction"
plan_file="$work_dir/plan"
parsed_file="$work_dir/parsed"
seen_file="$work_dir/seen"
: >"$requested_file"
: >"$transaction_file"

selected_group=
for requested_package in "$@"; do
    case "$requested_package" in
        ''|*[!A-Za-z0-9+_.-]*) die "invalid package name '$requested_package'" ;;
    esac
    if grep -qFx "$requested_package" "$requested_file"; then
        die "duplicate requested package '$requested_package'"
    fi
    printf '%s\n' "$requested_package" >>"$requested_file"

    if is_platform_package "$requested_package"; then
        die "package '$requested_package' is firmware-bound"
    fi

    class=$(package_class "$requested_package")
    case "$class" in
        safe|network-critical) ;;
        firmware-only) die "package '$requested_package' is firmware-only" ;;
        *) die "package '$requested_package' is not in the reviewed catalog" ;;
    esac

    candidate_group=$(package_group "$requested_package")
    [ -n "$candidate_group" ] || die "package '$requested_package' has no reviewed component group"
    if [ -z "$selected_group" ]; then
        selected_group=$candidate_group
    elif [ "$candidate_group" != "$selected_group" ]; then
        die "requested packages span multiple component groups"
    fi

    if ! "$APK_BIN" info -e "$requested_package" >/dev/null 2>&1; then
        case "$requested_package" in
            luci-i18n-*) ;;
            *) die "requested package '$requested_package' is not installed" ;;
        esac
    fi
done

while read -r member_group member_name extra; do
    case "$member_group" in ''|'#'*) continue ;; esac
    [ -z "${extra:-}" ] || die "malformed component group policy"
    [ "$member_group" = "$selected_group" ] || continue
    if "$APK_BIN" info -e "$member_name" >/dev/null 2>&1; then
        append_unique "$transaction_file" "$member_name"
    fi
done <"$GROUPS_FILE"

while IFS= read -r requested_package; do
    append_unique "$transaction_file" "$requested_package"
done <"$requested_file"

set --
while IFS= read -r package_name; do
    [ -n "$package_name" ] && set -- "$@" "$package_name"
done <"$transaction_file"
[ "$#" -gt 0 ] || die "component group has no installed package"

if ! "$APK_BIN" --simulate upgrade "$@" >"$plan_file" 2>&1; then
    cat "$plan_file" >&2
    die "apk rejected the simulated component-group upgrade"
fi
if ! parse_plan "$plan_file" "$parsed_file"; then
    die "solver plan contains an unsupported or malformed operation"
fi
validate_plan "$parsed_file" "$selected_group" "$seen_file"

exec "$APK_BIN" upgrade "$@"
