# ER1 final overrides. This fragment is applied after compile_base.config.

# Explicitly excluded applications from the final ER1 requirement.
# CONFIG_PACKAGE_smartdns is not set
# CONFIG_PACKAGE_luci-app-smartdns is not set
# CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn is not set
# CONFIG_PACKAGE_luci-app-quickfile is not set
# CONFIG_PACKAGE_quickstart is not set
# CONFIG_PACKAGE_luci-app-quickstart is not set
# CONFIG_PACKAGE_luci-i18n-quickstart-zh-cn is not set
# luci-app-istorex has a hard dependency on luci-app-quickstart.
# CONFIG_PACKAGE_luci-app-istorex is not set
# CONFIG_PACKAGE_luci-app-store is not set

# Keep the core uHTTPd service, but remove the unsafe advanced LuCI editor.
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
# CONFIG_PACKAGE_luci-app-uhttpd is not set
# CONFIG_PACKAGE_luci-i18n-uhttpd-zh-cn is not set

# Use LuCI's built-in Bootstrap theme by default and retain Argon as an option.
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-argon=y

# The shared NSS fragment supports wireless devices. ER1 has no Wi-Fi hardware,
# so these final overrides must remain after the NSS fragment in assembly order.
# CONFIG_ATH11K_MEM_PROFILE_512M is not set
# CONFIG_NSS_DRV_WIFI_MESH_ENABLE is not set
# CONFIG_PACKAGE_MAC80211_MESH is not set
# CONFIG_ATH11K_NSS_MESH_SUPPORT is not set
# CONFIG_PACKAGE_ath11k-firmware-ipq6018 is not set
# CONFIG_PACKAGE_ath11k-firmware-ipq6018-ddwrt is not set
# CONFIG_PACKAGE_ath11k-firmware-qcn9074 is not set
# CONFIG_PACKAGE_kmod-ath11k is not set
# CONFIG_PACKAGE_kmod-ath11k-ahb is not set
# CONFIG_PACKAGE_kmod-ath11k-pci is not set
# CONFIG_PACKAGE_hostapd-common is not set
# CONFIG_PACKAGE_wpad is not set
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_wpad-basic-openssl is not set
# CONFIG_PACKAGE_wpad-mesh-openssl is not set
