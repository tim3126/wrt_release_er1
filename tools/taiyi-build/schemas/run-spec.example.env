# Example only. Replace every placeholder with an absolute POSIX path or a
# non-secret identity. Do not put keys, tokens, credentials, or release values here.

RUN_WORKSPACE_DIR=/absolute/path/to/workspace
RUN_SOURCE_DIR=/absolute/path/to/prepared-source
RUN_CONTROL_DIR=/absolute/path/to/control-state
RUN_DL_CACHE_DIR=/absolute/path/to/cache/dl
RUN_CCACHE_DIR=/absolute/path/to/cache/.ccache
RUN_ARTIFACT_DIR=/absolute/path/to/candidate-output
CACHE_SCOPES=dl,.ccache
CACHE_MANIFEST_FILE=/absolute/path/to/cache-manifest.env
CACHE_IDENTITY_FILE=/absolute/path/to/cache-identity.env
TOOLCHAIN_IDENTITY=replace-with-non-secret-toolchain-identity
